# ═══════════════════════════════════════════════════════════════════════════
#  Fundación Kids Peque — Variables de Entorno PRODUCCIÓN
#  Renombrar este archivo a .env en el servidor
#  NUNCA subir al repositorio git
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=production

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://fundacionkidspeque.cl

# ── Base de Datos (PostgreSQL) ────────────────────────────────────────────────
# Reemplaza con los datos reales de Neon/Supabase o PostgreSQL del servidor
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── Transbank Webpay Plus (PRODUCCIÓN) ────────────────────────────────────────
TRANSBANK_COMMERCE_CODE=tu_codigo_comercio_real
TRANSBANK_API_KEY=tu_api_key_real
TRANSBANK_ENVIRONMENT=production
TRANSBANK_WEBHOOK_SECRET=cambia_esto_por_un_secreto_seguro_minimo_32_chars

# ── Flow.cl (PRODUCCIÓN) ──────────────────────────────────────────────────────
FLOW_API_KEY=tu_flow_api_key_real
FLOW_SECRET_KEY=tu_flow_secret_key_real
FLOW_ENVIRONMENT=production
FLOW_WEBHOOK_SECRET=cambia_esto_por_un_secreto_seguro_minimo_32_chars

# ── PayPal (PRODUCCIÓN) ───────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=tu_paypal_client_id_real
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret_real
PAYPAL_ENVIRONMENT=live
NEXT_PUBLIC_PAYPAL_CLIENT_ID=tu_paypal_client_id_publico_real
PAYPAL_WEBHOOK_ID=tu_paypal_webhook_id_real

# ── Email transaccional (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=re_tu_api_key_real
EMAIL_FROM="Fundación Kids Peque <no-reply@fundacionkidspeque.cl>"

# ── Cloudinary (almacenamiento imágenes) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name

# ── Admin Panel ───────────────────────────────────────────────────────────────
# Generar hash: node -e "const bcrypt=require('bcrypt');bcrypt.hash('tu_pass',12).then(console.log)"
ADMIN_PASSWORD_HASH='$2b$12$REEMPLAZA_CON_HASH_BCRYPT_REAL'
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET=REEMPLAZA_CON_64_CHARS_ALEATORIOS

# ── Cifrado de datos sensibles (RUTs) ─────────────────────────────────────────
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=REEMPLAZA_CON_32_BYTES_EN_BASE64
