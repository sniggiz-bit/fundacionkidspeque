# ═══════════════════════════════════════════════════════════════════════════
#  XUBOOK — Variables de Entorno
#  Copia este archivo como .env.local y rellena los valores.
#  NUNCA subas .env.local al repositorio (ya está en .gitignore)
# ═══════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Base de Datos (PostgreSQL 16+) ────────────────────────────────────────────
# Supabase o Neon recomendados
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/xubook?schema=public&sslmode=require"
DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/xubook?schema=public&sslmode=require"

# ─────────────────────────────────────────────────────────────────────────────
#  GATEWAYS DE PAGO
# ─────────────────────────────────────────────────────────────────────────────

# ── Transbank Webpay Plus (CLP — tarjetas nacionales) ─────────────────────────
# Sandbox: usar los valores de integración provistos por Transbank
# Producción: solicitar en https://www.transbank.cl/web/productos-y-servicios
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB837D7E88C7
# "integration" → apunta a webpay3gint.transbank.cl
# "production"  → apunta a webpay3g.transbank.cl
TRANSBANK_ENVIRONMENT=integration
# Secret para verificar firma HMAC de webhooks (definirlo tú mismo, mín. 32 chars)
TRANSBANK_WEBHOOK_SECRET=cambia_esto_por_un_secreto_seguro_de_32chars

# ── Flow.cl (CLP — múltiples medios de pago nacionales) ───────────────────────
# Credenciales en: https://www.flow.cl/app/web/developer.php
FLOW_API_KEY=tu_flow_api_key
FLOW_SECRET_KEY=tu_flow_secret_key
# "sandbox"    → api.flow.cl/api en modo pruebas
# "production" → api.flow.cl/api en modo real
FLOW_ENVIRONMENT=sandbox
FLOW_WEBHOOK_SECRET=cambia_esto_por_un_secreto_seguro_de_32chars

# ── PayPal (USD — donaciones internacionales) ─────────────────────────────────
# Credenciales en: https://developer.paypal.com/dashboard/applications
# Usar "sandbox" para pruebas, "live" para producción
PAYPAL_CLIENT_ID=ARxxxx_tu_paypal_client_id
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret
# "sandbox" → api-m.sandbox.paypal.com
# "live"    → api-m.paypal.com
PAYPAL_ENVIRONMENT=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=ARxxxx_tu_paypal_client_id_publico
# Webhook ID del panel de PayPal (para verificar eventos)
PAYPAL_WEBHOOK_ID=tu_paypal_webhook_id

# ─────────────────────────────────────────────────────────────────────────────
#  SERVICIOS DE SOPORTE
# ─────────────────────────────────────────────────────────────────────────────

# ── Email transaccional (recibos y notificaciones) ────────────────────────────
# Resend: https://resend.com (recomendado por su API simple)
RESEND_API_KEY=re_xxxx
EMAIL_FROM="Xubook <notificaciones@xubook.cl>"

# ── Almacenamiento de imágenes ────────────────────────────────────────────────
# Cloudinary: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name

# ── CMS Headless (gestión de contenido) ──────────────────────────────────────
# Sanity: https://www.sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=tu_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=sk_xxxx
SANITY_REVALIDATE_SECRET=cambia_esto_por_un_secreto_seguro

# ─────────────────────────────────────────────────────────────────────────────
#  SEGURIDAD Y ADMIN
# ─────────────────────────────────────────────────────────────────────────────

# ── Panel de administración ───────────────────────────────────────────────────
# Contraseña para acceder al panel /admin (usar hash bcrypt en producción)
ADMIN_PASSWORD_HASH='$2b$12$xxxx_genera_con_bcrypt'
# JWT secret para sesiones del admin (mín. 64 chars aleatorios)
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET=genera_64_bytes_aleatorios_aqui

# ── Cifrado de datos sensibles (RUTs) ─────────────────────────────────────────
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=genera_32_bytes_base64_aqui

# ─────────────────────────────────────────────────────────────────────────────
#  MONITOREO (OPCIONAL)
# ─────────────────────────────────────────────────────────────────────────────

SENTRY_DSN=https://xxxx@sentry.io/xxxx
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=tu_analytics_id

# ── Rate limiting (Upstash Redis — recomendado en Vercel) ─────────────────────
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx
